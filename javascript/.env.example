# Which model provider to use by default (see model-provider.js).
# One of: anthropic, openai, gemini, ollama. Defaults to "anthropic".
MODEL_PROVIDER=anthropic

# -- Anthropic (active by default) --
ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# -- OpenAI, only needed if MODEL_PROVIDER=openai --
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4.1

# -- Gemini, only needed if MODEL_PROVIDER=gemini --
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-2.5-flash

# -- Ollama, only needed if MODEL_PROVIDER=ollama, no API key required --
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# -- Shared --
# MAX_TOKENS=1024

# -- Avalanche / ChainKit --
# Free key from avacloud.io. Required for chainkit-fetch.js, advisor.js, and the
# ChainKit MCP server (npm run mcp-server, which chainkit-mcp-agent.js talks to).
GLACIER_API_KEY=your-glacier-key-here

# SSE endpoint of the ChainKit MCP server started with: npm run mcp-server
# (serves at http://localhost:2718/sse — change the port via MCP_PORT if needed)
CHAINKIT_MCP_URL=http://localhost:2718/sse

# A Fuji wallet address to query in the examples, yours or any public one
WALLET_ADDRESS=0xYourFujiWalletAddressHere
